# ============================================================
# SecureAssess — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=1

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=secureassess

# --- JWT ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_DEFAULT=30/minute

# --- Admin Seed (used by `flask seed-admin`) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@secureassess.local
ADMIN_PASSWORD=Admin@1234
